{
  "name": "@misofm/sdk-monorepo",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": ["packages/*"],
  "overrides": {
    "@mysten/sui": "2.28.0"
  },
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "codegen": "bun scripts/codegen.ts",
    "codegen:check": "bun run codegen && git diff --exit-code -- packages/protocol/src/contracts"
  },
  "devDependencies": {
    "@mysten/codegen": "^0.12.6",
    "@mysten/sui": "2.28.0",
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
